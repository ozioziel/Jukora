# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables. Copiar a `.env` (nunca versionar `.env`).
# En local, `npm run setup:local` crea `.env` y rellena los valores locales.
# Las variables VITE_* son PÚBLICAS: terminan en el navegador. Nunca poner claves privadas ahí.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──
NODE_ENV=development
APP_PUBLIC_URL=http://localhost:5173
API_PORT=3000
# DEMO: muestra etiquetas DEMO, habilita la entrada con llave de prueba (solo testnet) y la rampa QR simulada.
DEMO_MODE=true

# ── Base de datos (Supabase) ──
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
SUPABASE_URL=http://127.0.0.1:55321
# Privada. Local: la escribe setup:local. Remoto: Supabase → Project Settings → API keys (secret/service_role).
SUPABASE_SERVICE_ROLE_KEY=

# ── Sesión ──
# Privada. Mínimo 32 caracteres aleatorios.
SESSION_SECRET=

# ── Stellar ──
# Solo `testnet` está permitido sin aprobación expresa de mainnet.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Dirección pública de la plataforma (recibe la comisión y firma la liberación tras la aprobación del comprador).
PLATFORM_STELLAR_ADDRESS=
# Privada, SOLO testnet: firma la liberación (releaseSigner) y el despliegue del escrow DEMO.
PLATFORM_STELLAR_SECRET=
# Dirección pública del árbitro (disputeResolver). En la demo, una cuenta separada de prueba.
ARBITER_STELLAR_ADDRESS=
# Token de prueba (no es USDC): lo crea `npm run stellar:setup`.
DEMO_TOKEN_CODE=USDCDEMO
DEMO_TOKEN_ISSUER=
DEMO_TOKEN_CONTRACT_ID=
# Privada, SOLO testnet: emite token de prueba para la rampa QR simulada.
DEMO_TOKEN_ISSUER_SECRET=

# ── Trustless Work (escrow) ──
TW_API_URL=https://dev.api.trustlesswork.com
# Privada. dapp.trustlesswork.com → Settings → API Keys → Testnet.
TW_API_KEY=

# ── Pollar (login con correo, wallet y rampas QR) ──
# Pública: dashboard.pollar.xyz → Developers → API keys (pub_testnet_…).
VITE_POLLAR_PUBLISHABLE_KEY=
# Privada (sec_testnet_…).
POLLAR_SECRET_KEY=
POLLAR_API_URL=https://api.pollar.xyz

# ── KYC / KYB (Didit sandbox) ──
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# Privada. Para la huella HMAC del documento (nunca se guarda el número).
KYC_HMAC_SECRET=

# ── IA (plan de recursos) ──
# groq | ollama | demo   (demo = reglas deterministas, etiquetado, sin IA)
AI_PROVIDER=demo
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b-instruct

# ── Búsqueda externa ──
# tavily | none   (none = solo catálogo propio)
SEARCH_PROVIDER=none
TAVILY_API_KEY=
# Tope global diario de créditos externos (presupuesto 0 USD: 1.000 créditos/mes ≈ 30/día).
SEARCH_DAILY_CREDIT_CAP=30
# Créditos máximos por búsqueda inteligente (incluye categorías abiertas después).
SEARCH_RUN_CREDIT_BUDGET=8

# ── Comisión de plataforma ──
PLATFORM_FEE_BPS=250
PLATFORM_FEE_MIN=1

# ── Web (públicas) ──
VITE_API_URL=/api
VITE_STELLAR_NETWORK=testnet
VITE_DEMO_MODE=true
